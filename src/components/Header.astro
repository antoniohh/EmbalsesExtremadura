---
import Brand from "./Brand.astro";
import { fechaActualizacion } from "../lib/data";
import { formatDateShort } from "../lib/format";

const path = Astro.url.pathname;
const isHome = path === "/";
const isMetodologia = path.startsWith("/metodologia");
const fecha = formatDateShort(fechaActualizacion);
const fechaCompacta = fecha.replace(/\s\d{4}$/, "");
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-slate-50/95">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <Brand />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      <a
        href="/"
        class:list={[
          "rounded-full px-3.5 py-2 text-sm font-medium transition-colors",
          isHome
            ? "bg-white text-slate-950 shadow-sm ring-1 ring-slate-200"
            : "text-slate-600 hover:bg-white hover:text-slate-950",
        ]}
      >
        Panel
      </a>
      <a
        href="/#embalses"
        class="rounded-full px-3.5 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-white hover:text-slate-950"
      >
        Embalses
      </a>
      <a
        href="/#preguntas-frecuentes"
        class="rounded-full px-3.5 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-white hover:text-slate-950"
      >
        Preguntas
      </a>
      <a
        href="/metodologia/"
        class:list={[
          "rounded-full px-3.5 py-2 text-sm font-medium transition-colors",
          isMetodologia
            ? "bg-white text-slate-950 shadow-sm ring-1 ring-slate-200"
            : "text-slate-600 hover:bg-white hover:text-slate-950",
        ]}
      >
        Metodología
      </a>
    </nav>

    <a
      href="/metodologia/"
      class="flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full border border-slate-200 bg-white px-2.5 py-1.5 text-[11px] font-medium text-slate-600 shadow-sm transition-colors hover:border-slate-300 hover:text-slate-950 sm:px-3 sm:text-xs"
      title="Fecha del boletín hidrológico y metodología"
      aria-label={`Boletín semanal del ${fecha}. Ver metodología y fuentes.`}
    >
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      </span>
      <span class="hidden md:inline">Boletín semanal</span>
      <span class="hidden text-slate-400 md:inline" aria-hidden="true">·</span>
      <span class="hidden whitespace-nowrap tnum sm:inline">{fecha}</span>
      <span class="whitespace-nowrap sm:hidden">{fechaCompacta}</span>
    </a>
  </div>
</header>
