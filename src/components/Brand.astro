---
import Logo from "./Logo.astro";
---

<a
  href="/"
  class="group flex items-center gap-3 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-4 focus-visible:ring-offset-slate-50"
  aria-label="Embalses de Extremadura, ir al panel principal"
>
  <Logo class="h-9 w-9" />
  <span class="flex flex-col leading-none">
    <span class="text-[13px] font-semibold tracking-[-0.01em] text-slate-950 sm:text-[15px]">
      Embalses <span class="font-normal text-slate-500">de Extremadura</span>
    </span>
    <span class="mt-1 hidden text-[10px] font-medium uppercase tracking-[0.14em] text-slate-500 sm:block">
      Panel público del agua
    </span>
  </span>
</a>
