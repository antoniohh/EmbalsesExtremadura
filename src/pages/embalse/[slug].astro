---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { HistoricalChart } from "../../components/react/HistoricalChart";
import { LiveReading } from "../../components/react/LiveReading";
import { TrendBadge } from "../../components/react/TrendBadge";
import { WaterBar } from "../../components/react/WaterBar";
import { aggregate, availableHm3, variationPoints } from "../../lib/aggregate";
import { data, embalses } from "../../lib/data";
import { absoluteUrl, AUTHOR_NAME, AUTHOR_URL, SITE } from "../../lib/site";
import {
  clamp,
  formatDateLong,
  formatDateShort,
  formatDecimal,
  formatHm3,
  formatPctCompact,
  formatSignedPct,
} from "../../lib/format";
import type { Embalse } from "../../types";
import {
  TriangleExclamationPoint,
  ArrowDownUp,
  ArrowRight,
  ArrowUpRight,
  CalendarDays,
  ChevronRight,
  Container,
  Database,
  Droplet,
  ExternalLink,
  Gauge,
  MapPin,
  Ruler,
  WavesHorizontal,
} from "@lucide/astro";

export function getStaticPaths() {
  return data.embalses.map((embalse) => ({
    params: { slug: embalse.slug },
    props: { embalse },
  }));
}

const { embalse } = Astro.props as { embalse: Embalse };

const cuencaStats = aggregate(embalses.filter((item) => item.cuenca === embalse.cuenca));
const related = embalses
  .filter((item) => item.cuenca === embalse.cuenca && item.slug !== embalse.slug)
  .sort((a, b) => b.capacidad_hm3 - a.capacidad_hm3)
  .slice(0, 4);

const available = availableHm3(embalse);
const difference = embalse.porcentaje - cuencaStats.porcentaje;
const variationPct = variationPoints(embalse);
const freePct = clamp(100 - embalse.porcentaje, 0, 100);
const dateLabel = formatDateLong(embalse.fecha_actualizacion);
const previousPoint = embalse.historico.length > 1 ? embalse.historico[embalse.historico.length - 2] : null;

const trend =
  embalse.variacion_semana_hm3 > 0.0001
    ? `En la última semana ha ganado ${formatHm3(embalse.variacion_semana_hm3)} hm³ (${formatSignedPct(variationPct)}).`
    : embalse.variacion_semana_hm3 < -0.0001
      ? `En la última semana ha perdido ${formatHm3(Math.abs(embalse.variacion_semana_hm3))} hm³ (${formatSignedPct(variationPct)}).`
      : "Su volumen se ha mantenido estable en la última semana.";

const comparison =
  Math.abs(difference) < 0.005
    ? `Se sitúa prácticamente en la media ponderada de la cuenca del ${embalse.cuenca} (${formatDecimal(cuencaStats.porcentaje)} %).`
    : difference > 0
      ? `Se sitúa ${formatDecimal(difference)} puntos porcentuales por encima de la media ponderada de la cuenca del ${embalse.cuenca} (${formatDecimal(cuencaStats.porcentaje)} %).`
      : `Se sitúa ${formatDecimal(Math.abs(difference))} puntos porcentuales por debajo de la media ponderada de la cuenca del ${embalse.cuenca} (${formatDecimal(cuencaStats.porcentaje)} %).`;

const paragraph = `El embalse de ${embalse.nombre} se encuentra actualmente al ${formatDecimal(
  embalse.porcentaje,
)} % de su capacidad total, albergando ${formatHm3(embalse.actual_hm3)} hm³ de agua de los ${formatHm3(
  embalse.capacidad_hm3,
)} hm³ que puede almacenar. ${trend} ${comparison}`;

const title = `Embalse de ${embalse.nombre}: nivel y capacidad | Embalses de Extremadura`;
const description = `El embalse de ${embalse.nombre} (${embalse.provincia}) está al ${formatDecimal(
  embalse.porcentaje,
)}% de su capacidad: ${formatHm3(embalse.actual_hm3)} hm³ de ${formatHm3(
  embalse.capacidad_hm3,
)} hm³. Variación semanal, histórico y datos del MITECO.`;
const canonicalPath = `/embalse/${embalse.slug}/`;
const temporalCoverage =
  embalse.historico.length > 1
    ? `${embalse.historico[0].fecha}/${embalse.fecha_actualizacion}`
    : embalse.fecha_actualizacion;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${absoluteUrl(canonicalPath)}#webpage`,
      url: absoluteUrl(canonicalPath),
      name: title,
      description,
      isPartOf: { "@id": `${SITE}/#website` },
      inLanguage: "es-ES",
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: absoluteUrl("assets/og-image.png"),
        width: 1200,
        height: 630,
      },
    },
    {
      "@type": "Dataset",
      "@id": `${absoluteUrl(canonicalPath)}#dataset`,
      name: `Embalse de ${embalse.nombre}: nivel y capacidad`,
      description,
      url: absoluteUrl(canonicalPath),
      dateModified: embalse.fecha_actualizacion,
      temporalCoverage,
      spatialCoverage: {
        "@type": "Place",
        name: `${embalse.nombre}, ${embalse.provincia}, Extremadura`,
      },
      variableMeasured: [
        "Volumen embalsado (hm³)",
        "Capacidad total (hm³)",
        "Porcentaje de llenado (%)",
        "Variación semanal (hm³)",
      ],
      creator: { "@type": "Person", name: AUTHOR_NAME, url: AUTHOR_URL },
      isBasedOn:
        "https://www.miteco.gob.es/es/agua/temas/evaluacion-de-los-recursos-hidricos/boletin-hidrologico/",
      license: "https://creativecommons.org/licenses/by/4.0/",
      distribution: [
        {
          "@type": "DataDownload",
          encodingFormat: "application/json",
          contentUrl: absoluteUrl("datos/embalses.json"),
        },
      ],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: absoluteUrl("/") },
        {
          "@type": "ListItem",
          position: 2,
          name: `Embalses de ${embalse.provincia}`,
          item: absoluteUrl(`/?provincia=${encodeURIComponent(embalse.provincia)}`),
        },
        {
          "@type": "ListItem",
          position: 3,
          name: embalse.nombre,
          item: absoluteUrl(canonicalPath),
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
    <nav aria-label="Migas de pan" class="text-sm">
      <ol class="flex flex-wrap items-center gap-1.5 text-slate-500">
        <li><a href="/" class="transition-colors hover:text-slate-950">Inicio</a></li>
        <li aria-hidden="true"><ChevronRight class="h-3.5 w-3.5 text-slate-300" /></li>
        <li>
          <a href={`/?provincia=${encodeURIComponent(embalse.provincia)}`} class="transition-colors hover:text-slate-950">
            Embalses de {embalse.provincia}
          </a>
        </li>
        <li aria-hidden="true"><ChevronRight class="h-3.5 w-3.5 text-slate-300" /></li>
        <li aria-current="page" class="font-medium text-slate-900">{embalse.nombre}</li>
      </ol>
    </nav>

    <article class="mt-6">
      <header class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-600 ring-1 ring-inset ring-slate-200">
              <MapPin class="h-3 w-3" aria-hidden="true" />
              {embalse.provincia}
            </span>
            <span
              class:list={[
                "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-medium ring-1 ring-inset",
                embalse.cuenca === "Guadiana"
                  ? "bg-cyan-50 text-cyan-800 ring-cyan-200/70"
                  : "bg-blue-50 text-blue-800 ring-blue-200/70",
              ]}
            >
              <span
                class:list={[
                  "h-1.5 w-1.5 rounded-full",
                  embalse.cuenca === "Guadiana" ? "bg-cyan-500" : "bg-blue-500",
                ]}
                aria-hidden="true"
              ></span>
              Cuenca del {embalse.cuenca}
            </span>
            {embalse.rio && (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 text-[11px] font-medium text-slate-600 ring-1 ring-inset ring-slate-200">
                <WavesHorizontal class="h-3 w-3" aria-hidden="true" />
                Río {embalse.rio}
              </span>
            )}
            {embalse.porcentaje < 25 && (
              <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-1 text-[11px] font-semibold text-amber-800 ring-1 ring-inset ring-amber-200">
                <TriangleExclamationPoint class="h-3 w-3" aria-hidden="true" />
                Nivel bajo
              </span>
            )}
          </div>

          <h1 class="mt-4 text-balance text-[clamp(2.25rem,5vw,3.6rem)] font-bold leading-[1.02] tracking-[-0.04em] text-slate-950">
            Embalse de <span class="text-blue-700">{embalse.nombre}</span>
          </h1>

          <p class="mt-3 max-w-2xl text-pretty text-[15px] leading-relaxed text-slate-600 sm:text-base">
            {[embalse.municipio, embalse.provincia, `cuenca del ${embalse.cuenca}`].filter(Boolean).join(" · ")}
            {embalse.rio ? `. Río ${embalse.rio}.` : "."}
          </p>

          <p class="mt-3 inline-flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-slate-500">
            <span class="inline-flex items-center gap-2">
              <CalendarDays class="h-4 w-4 text-slate-400" aria-hidden="true" />
              Datos del {dateLabel}
            </span>
            <span class="inline-flex items-center gap-2">
              <Database class="h-4 w-4 text-slate-400" aria-hidden="true" />
              MITECO · MapasDeEmbalses.es
            </span>
          </p>
        </div>

        <div class="surface w-full p-6 shadow-[var(--shadow-lift)] sm:p-7 lg:w-[22rem]">
          <p class="flex items-end gap-1.5">
            <span class="text-[4.4rem] font-semibold leading-none tracking-[-0.055em] text-slate-950 tnum">
              {formatDecimal(embalse.porcentaje)}
            </span>
            <span class="pb-2 text-2xl font-medium text-slate-500">%</span>
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <TrendBadge value={embalse.variacion_semana_hm3} size="lg" showRange />
            <span class="text-xs text-slate-500">
              {previousPoint ? `frente al ${formatDateShort(previousPoint.fecha)}` : "última semana"}
            </span>
          </div>

          <WaterBar
            value={embalse.porcentaje}
            label={`${embalse.nombre}: ${formatPctCompact(embalse.porcentaje)} de su capacidad`}
            height="md"
            className="mt-5"
          />
          <div class="mt-2 flex items-center justify-between text-xs text-slate-500 tnum">
            <span>{formatHm3(embalse.actual_hm3)} hm³ embalsados</span>
            <span>{formatHm3(embalse.capacidad_hm3)} hm³</span>
          </div>
        </div>
      </header>

      <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Métricas técnicas del embalse">
        <article class="surface flex min-w-0 flex-col p-5">
          <div class="flex items-center gap-2.5">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-600 ring-1 ring-slate-200">
              <Ruler class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-[13px] font-semibold leading-tight text-slate-700">Capacidad máxima</h2>
          </div>
          <p class="mt-4 flex items-baseline gap-1.5">
            <span class="text-[2rem] font-semibold leading-none tracking-[-0.035em] text-slate-950 tnum">
              {formatHm3(embalse.capacidad_hm3)}
            </span>
            <span class="text-sm font-medium text-slate-500">hm³</span>
          </p>
          <p class="mt-1.5 text-[13px] leading-relaxed text-slate-500">Volumen máximo del vaso</p>
        </article>

        <article class="surface flex min-w-0 flex-col p-5">
          <div class="flex items-center gap-2.5">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-cyan-50 text-cyan-700 ring-1 ring-cyan-100">
              <Droplet class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-[13px] font-semibold leading-tight text-slate-700">Volumen embalsado</h2>
          </div>
          <p class="mt-4 flex items-baseline gap-1.5">
            <span class="text-[2rem] font-semibold leading-none tracking-[-0.035em] text-slate-950 tnum">
              {formatHm3(embalse.actual_hm3)}
            </span>
            <span class="text-sm font-medium text-slate-500">hm³</span>
          </p>
          <p class="mt-1.5 text-[13px] leading-relaxed text-slate-500">
            {formatPctCompact(embalse.porcentaje)} de la capacidad
          </p>
          <div class="mt-auto pt-4">
            <WaterBar
              value={embalse.porcentaje}
              label={`${embalse.nombre}: ${formatPctCompact(embalse.porcentaje)} de su capacidad`}
            />
          </div>
        </article>

        <article class="surface flex min-w-0 flex-col p-5">
          <div class="flex items-center gap-2.5">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-700 ring-1 ring-blue-100">
              <Container class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-[13px] font-semibold leading-tight text-slate-700">Espacio disponible</h2>
          </div>
          <p class="mt-4 flex items-baseline gap-1.5">
            <span class="text-[2rem] font-semibold leading-none tracking-[-0.035em] text-slate-950 tnum">
              {formatHm3(available)}
            </span>
            <span class="text-sm font-medium text-slate-500">hm³</span>
          </p>
          <p class="mt-1.5 text-[13px] leading-relaxed text-slate-500">{formatDecimal(freePct)} % libre</p>
          <div class="mt-auto pt-4">
            <WaterBar
              value={freePct}
              label={`${embalse.nombre}: ${formatDecimal(freePct)} % de capacidad libre`}
              tone="blue"
            />
          </div>
        </article>

        <article class="surface flex min-w-0 flex-col p-5">
          <div class="flex items-center gap-2.5">
            <span
              class:list={[
                "flex h-8 w-8 items-center justify-center rounded-lg ring-1",
                embalse.variacion_semana_hm3 > 0.0001
                  ? "bg-emerald-50 text-emerald-700 ring-emerald-100"
                  : embalse.variacion_semana_hm3 < -0.0001
                    ? "bg-rose-50 text-rose-700 ring-rose-100"
                    : "bg-slate-100 text-slate-600 ring-slate-200",
              ]}
            >
              <ArrowDownUp class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-[13px] font-semibold leading-tight text-slate-700">Variación en 7 días</h2>
          </div>
          <p class="mt-4 flex items-baseline gap-1.5">
            <span class="text-[2rem] font-semibold leading-none tracking-[-0.035em] text-slate-950 tnum">
              {embalse.variacion_semana_hm3 > 0 ? "+" : ""}{formatHm3(embalse.variacion_semana_hm3)}
            </span>
            <span class="text-sm font-medium text-slate-500">hm³</span>
          </p>
          <p class="mt-1.5 text-[13px] leading-relaxed text-slate-500">
            {formatSignedPct(variationPct)} · {previousPoint ? `frente al ${formatDateShort(previousPoint.fecha)}` : "última semana"}
          </p>
        </article>
      </section>

      <section class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(18rem,0.75fr)]">
        <div class="surface self-start p-5 sm:p-6">
          <HistoricalChart client:visible data={embalse.historico} />
        </div>

        <aside class="flex flex-col gap-6">
          <div class="surface p-5 sm:p-6">
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-slate-950">Ficha del embalse</h2>
            <dl class="mt-4 divide-y divide-slate-100 text-sm">
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="text-slate-500">Provincia</dt>
                <dd class="font-medium text-slate-900">{embalse.provincia}</dd>
              </div>
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="text-slate-500">Cuenca</dt>
                <dd class="font-medium text-slate-900">{embalse.cuenca}</dd>
              </div>
              {embalse.rio && (
                <div class="flex items-center justify-between gap-4 py-2.5">
                  <dt class="text-slate-500">Río</dt>
                  <dd class="font-medium text-slate-900">{embalse.rio}</dd>
                </div>
              )}
              {embalse.municipio && (
                <div class="flex items-center justify-between gap-4 py-2.5">
                  <dt class="text-slate-500">Municipio</dt>
                  <dd class="text-right font-medium text-slate-900">{embalse.municipio}</dd>
                </div>
              )}
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="text-slate-500">Capacidad</dt>
                <dd class="font-medium text-slate-900 tnum">{formatHm3(embalse.capacidad_hm3)} hm³</dd>
              </div>
              <div class="flex items-center justify-between gap-4 py-2.5">
                <dt class="text-slate-500">Última actualización</dt>
                <dd class="font-medium text-slate-900">{formatDateShort(embalse.fecha_actualizacion)}</dd>
              </div>
            </dl>
            <p class="mt-4 text-[11px] leading-relaxed text-slate-500">
              Datos del Boletín Hidrológico Semanal del MITECO, normalizados por MapasDeEmbalses.es.
            </p>
          </div>

          <LiveReading client:idle slug={embalse.slug} initial={embalse.dato_reciente ?? null} />

          <div class="surface p-5 sm:p-6">
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-slate-950">En su cuenca</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              La cuenca del {embalse.cuenca} se encuentra al{' '}
              <span class="font-semibold text-slate-900 tnum">{formatDecimal(cuencaStats.porcentaje)} %</span> de su
              capacidad ponderada, con {cuencaStats.total} embalses con dato.
            </p>
            <WaterBar
              value={cuencaStats.porcentaje}
              label={`Cuenca del ${embalse.cuenca}: ${formatPctCompact(cuencaStats.porcentaje)} de capacidad`}
              className="mt-4"
            />
            <div class="mt-4 flex items-start gap-2 rounded-xl bg-slate-50 px-3.5 py-3 text-sm ring-1 ring-inset ring-slate-100">
              <Gauge class="mt-0.5 h-4 w-4 shrink-0 text-slate-400" aria-hidden="true" />
              <p class="text-slate-600">
                {Math.abs(difference) < 0.005 ? (
                  <>Este embalse está <span class="font-semibold text-slate-900">en la media</span> de la cuenca.</>
                ) : (
                  <>
                    Este embalse está{' '}
                    <span class:list={["font-semibold", difference > 0 ? "text-blue-700" : "text-amber-700"]}>
                      {formatDecimal(Math.abs(difference))} pp {difference > 0 ? "por encima" : "por debajo"}
                    </span>{' '}
                    de la media de la cuenca.
                  </>
                )}
              </p>
            </div>
          </div>
        </aside>
      </section>

      <section class="surface mt-6 p-5 sm:p-6" aria-labelledby="significado-dato">
        <h2 id="significado-dato" class="text-xl font-bold tracking-[-0.025em] text-slate-950">
          Qué significa este dato
        </h2>
        <p class="mt-3 max-w-3xl text-pretty text-[15px] leading-relaxed text-slate-600">{paragraph}</p>
        <p class="mt-3 max-w-3xl text-pretty text-[15px] leading-relaxed text-slate-600">
          El porcentaje se calcula sobre la capacidad máxima del embalse y la variación compara las dos últimas
          semanas publicadas. Los datos proceden del boletín hidrológico del MITECO y pueden estar sujetos a
          revisión. Esta ficha no sustituye a los avisos oficiales de la Confederación Hidrográfica del{' '}
          {embalse.cuenca}.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
          <a href="/metodologia/" class="inline-flex items-center gap-2 font-semibold text-blue-700 transition-colors hover:text-blue-800">
            Cómo calculamos la variación semanal
            <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <a
            href="https://www.miteco.gob.es/es/agua/temas/evaluacion-de-los-recursos-hidricos/boletin-hidrologico/"
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 font-medium text-slate-600 transition-colors hover:text-slate-950"
          >
            Consultar el boletín del MITECO
            <ExternalLink class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </div>
      </section>

      {related.length > 0 && (
        <section class="mt-12" aria-labelledby="otros-embalses">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h2 id="otros-embalses" class="text-2xl font-bold tracking-[-0.03em] text-slate-950">
                Más embalses de la cuenca del {embalse.cuenca}
              </h2>
              <p class="mt-1 text-sm text-slate-500">Compara el nivel con otros embalses de la misma cuenca.</p>
            </div>
            <a
              href={`/?cuenca=${embalse.cuenca}`}
              class="inline-flex items-center gap-2 text-sm font-semibold text-blue-700 transition-colors hover:text-blue-800"
            >
              Ver la cuenca completa
              <ArrowRight class="h-4 w-4" aria-hidden="true" />
            </a>
          </div>

          <div class="surface mt-5 divide-y divide-slate-100 overflow-hidden">
            {related.map((item) => (
              <a
                href={`/embalse/${item.slug}/`}
                class="group flex items-center gap-4 px-4 py-3.5 transition-colors hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 sm:px-5"
              >
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-semibold text-slate-900 group-hover:text-blue-800">{item.nombre}</p>
                  <p class="mt-0.5 truncate text-xs text-slate-500">
                    {item.provincia}{item.rio ? ` · ${item.rio}` : ""}
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-sm font-semibold text-slate-900 tnum">{formatPctCompact(item.porcentaje)}</p>
                  <p class="text-[11px] text-slate-500 tnum">
                    {formatHm3(item.actual_hm3)} / {formatHm3(item.capacidad_hm3)} hm³
                  </p>
                </div>
                <TrendBadge value={item.variacion_semana_hm3} className="hidden sm:inline-flex" />
                <ChevronRight
                  class="h-4 w-4 shrink-0 text-slate-300 transition-transform group-hover:translate-x-0.5 group-hover:text-slate-500"
                  aria-hidden="true"
                />
              </a>
            ))}
          </div>
        </section>
      )}

      <p class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-slate-500">
        <span>Última actualización: {dateLabel}.</span>
        <span>Fuente original: MITECO (CC BY 4.0).</span>
        <span>Normalización: MapasDeEmbalses.es.</span>
      </p>
    </article>
  </div>
</BaseLayout>
