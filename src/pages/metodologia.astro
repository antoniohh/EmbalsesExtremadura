---
import BaseLayout from "../layouts/BaseLayout.astro";
import { embalses, fechaActualizacion, totalCatalogo } from "../lib/data";
import { absoluteUrl, AUTHOR_NAME, AUTHOR_URL, SITE } from "../lib/site";
import { formatDateLong } from "../lib/format";
import {
  TriangleExclamationPoint,
  ArrowLeft,
  ArrowRight,
  CalendarClock,
  Database,
  ExternalLink,
  Info,
  RefreshCw,
  Scale,
  WavesHorizontal,
} from "@lucide/astro";

const dateLabel = formatDateLong(fechaActualizacion);
const title = "Metodología y fuentes de los datos | Embalses de Extremadura";
const description =
  "Cómo obtenemos y calculamos el nivel, la capacidad y la variación semanal de los embalses de Extremadura. Fuente MITECO, agregados ponderados y límites de uso.";
const canonicalPath = "/metodologia/";

const sections = [
  { id: "fuente", label: "Fuente y frecuencia" },
  { id: "cifras", label: "Qué mide cada cifra" },
  { id: "agregados", label: "Agregados" },
  { id: "cobertura", label: "Cobertura" },
  { id: "variacion", label: "Variación semanal" },
  { id: "frescura", label: "Frescura y respaldo" },
  { id: "atribucion", label: "Atribución" },
  { id: "limites", label: "Límites de uso" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${absoluteUrl(canonicalPath)}#webpage`,
      url: absoluteUrl(canonicalPath),
      name: title,
      description,
      isPartOf: { "@id": `${SITE}/#website` },
      inLanguage: "es-ES",
    },
    {
      "@type": "Article",
      "@id": `${absoluteUrl(canonicalPath)}#article`,
      headline: "Metodología y fuentes de los datos de embalses de Extremadura",
      description,
      dateModified: fechaActualizacion,
      inLanguage: "es-ES",
      mainEntityOfPage: { "@id": `${absoluteUrl(canonicalPath)}#webpage` },
      author: { "@type": "Person", name: AUTHOR_NAME, url: AUTHOR_URL },
      publisher: { "@type": "Person", name: AUTHOR_NAME, url: AUTHOR_URL },
      about: {
        "@type": "Dataset",
        name: "Estado de los embalses de Extremadura",
        isBasedOn:
          "https://www.miteco.gob.es/es/agua/temas/evaluacion-de-los-recursos-hidricos/boletin-hidrologico/",
        license: "https://creativecommons.org/licenses/by/4.0/",
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: absoluteUrl("/") },
        { "@type": "ListItem", position: 2, name: "Metodología", item: absoluteUrl(canonicalPath) },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} ogType="article" jsonLd={jsonLd}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 transition-colors hover:text-slate-950">
      <ArrowLeft class="h-4 w-4" aria-hidden="true" />
      Volver al panel
    </a>

    <header class="mt-6 max-w-3xl">
      <h1 class="text-balance text-[clamp(2.2rem,4.5vw,3.4rem)] font-bold leading-[1.03] tracking-[-0.04em] text-slate-950">
        Metodología y fuentes de los datos
      </h1>
      <p class="mt-4 text-pretty text-lg leading-relaxed text-slate-600">
        Cómo pasamos del boletín hidrológico semanal del MITECO a un panel útil para consultar el agua embalsada en
        Extremadura, con sus límites y su trazabilidad.
      </p>
      <p class="mt-3 inline-flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-slate-500">
        <span>Referencia del {dateLabel}</span>
        <span class="tnum">{embalses.length} embalses con dato de {totalCatalogo} en el catálogo</span>
        <span>Actualización semanal</span>
      </p>
    </header>

    <nav aria-label="En esta página" class="mt-8 flex flex-wrap gap-2">
      {sections.map((section) => (
        <a
          href={`#${section.id}`}
          class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-950"
        >
          {section.label}
        </a>
      ))}
    </nav>

    <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-10">
      <article class="space-y-5">
        <section id="fuente" class="surface scroll-mt-24 p-5 sm:p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
              <Database class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-slate-950">Fuente y frecuencia</h2>
          </div>
          <div class="mt-4 max-w-3xl space-y-3 text-[15px] leading-relaxed text-slate-600">
            <p>
              Los datos proceden del <strong class="font-semibold text-slate-900">Boletín Hidrológico Semanal</strong>{' '}
              del Ministerio para la Transición Ecológica y el Reto Demográfico (MITECO), que se publica cada martes
              con la reserva hidráulica de los principales embalses. La capa de normalización y acceso es{' '}
              <a href="https://mapasdeembalses.es/" target="_blank" rel="noreferrer" class="link-underline font-medium text-blue-700">
                MapasDeEmbalses.es
              </a>
              , que conserva la fuente original en cada dato.
            </p>
            <p>
              La aplicación se genera de forma estática. Un proceso de GitHub Actions descarga los datos, construye
              las 42 fichas y publica el sitio en GitHub Pages. No hay consultas a la API en cada visita: el HTML ya
              llega con los datos del último boletín.
            </p>
            <p class="rounded-xl bg-slate-50 px-4 py-3 text-sm ring-1 ring-inset ring-slate-100">
              <strong class="font-semibold text-slate-900">Fecha de referencia:</strong> {dateLabel}. El boletín se
              publica los martes; los datos pueden incorporarse a la fuente normalizada unas horas después.
            </p>
          </div>
        </section>

        <section id="cifras" class="surface scroll-mt-24 p-5 sm:p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
              <Scale class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-slate-950">Qué mide cada cifra</h2>
          </div>
          <div class="mt-4 max-w-3xl overflow-x-auto">
            <table class="w-full min-w-[34rem] text-left text-sm">
              <caption class="sr-only">Definición de las métricas que muestra el panel</caption>
              <thead>
                <tr class="border-b border-slate-200 text-slate-500">
                  <th scope="col" class="py-2 pr-4 font-semibold">Métrica</th>
                  <th scope="col" class="py-2 font-semibold">Qué significa</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr>
                  <th scope="row" class="py-2.5 pr-4 font-medium text-slate-900">Capacidad máxima</th>
                  <td class="py-2.5">Volumen máximo que puede almacenar el embalse a nivel normal, en hm³.</td>
                </tr>
                <tr>
                  <th scope="row" class="py-2.5 pr-4 font-medium text-slate-900">Volumen embalsado</th>
                  <td class="py-2.5">Agua almacenada en la fecha de referencia, en hectómetros cúbicos.</td>
                </tr>
                <tr>
                  <th scope="row" class="py-2.5 pr-4 font-medium text-slate-900">Porcentaje de llenado</th>
                  <td class="py-2.5">Volumen embalsado dividido entre la capacidad máxima, expresado en %.</td>
                </tr>
                <tr>
                  <th scope="row" class="py-2.5 pr-4 font-medium text-slate-900">Espacio disponible</th>
                  <td class="py-2.5">Capacidad máxima menos volumen embalsado: lo que aún puede entrar.</td>
                </tr>
                <tr>
                  <th scope="row" class="py-2.5 pr-4 font-medium text-slate-900">Variación semanal</th>
                  <td class="py-2.5">Diferencia de volumen respecto a la semana anterior publicada.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="agregados" class="surface scroll-mt-24 p-5 sm:p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
              <WavesHorizontal class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-slate-950">Cómo se calculan los agregados</h2>
          </div>
          <div class="mt-4 max-w-3xl space-y-3 text-[15px] leading-relaxed text-slate-600">
            <p>
              Los porcentajes de Extremadura, Guadiana y Tajo son{' '}
              <strong class="font-semibold text-slate-900">medias ponderadas por capacidad</strong>, no medias simples
              de los porcentajes. Es decir: se suma el agua embalsada y se divide entre la capacidad conjunta de los
              embalses con dato.
            </p>
            <p>
              Este criterio evita que un embalse pequeño con un porcentaje llamativo distorsione la lectura de una
              cuenca. Por eso el porcentaje agregado puede no coincidir con la media aritmética de las fichas.
            </p>
            <p class="rounded-xl bg-cyan-50 px-4 py-3 text-sm text-cyan-950 ring-1 ring-inset ring-cyan-100">
              Solo entran en los agregados los embalses que tienen volumen y capacidad publicados. Un dato ausente no
              se convierte en cero ni se estima.
            </p>
          </div>
        </section>

        <section id="cobertura" class="surface scroll-mt-24 p-5 sm:p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
              <Info class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-slate-950">Cobertura y valores ausentes</h2>
          </div>
          <div class="mt-4 max-w-3xl space-y-3 text-[15px] leading-relaxed text-slate-600">
            <p>
              El catálogo de Extremadura incluye {totalCatalogo} embalses. En esta edición hay{' '}
              <strong class="font-semibold text-slate-900">{embalses.length} con dato</strong> de volumen y capacidad;
              el resto aparece en el catálogo de la fuente pero no se incluye en el panel para no mostrar cifras
              incompletas.
            </p>
            <p>
              Cuando una semana falta un valor, la serie conserva el hueco: no se interpola ni se rellena. En la ficha,
              la gráfica muestra únicamente las semanas con dato y la tabla permite revisar la serie completa
              disponible.
            </p>
          </div>
        </section>

        <section id="variacion" class="surface scroll-mt-24 p-5 sm:p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
              <CalendarClock class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-slate-950">Variación semanal</h2>
          </div>
          <div class="mt-4 max-w-3xl space-y-3 text-[15px] leading-relaxed text-slate-600">
            <p>
              La variación compara el volumen de la última semana con el de la semana anterior publicada. Se muestra en
              hm³ y, en la ficha, también en puntos porcentuales sobre la capacidad del embalse. El color verde indica
              subida, el rojo bajada y el gris estabilidad.
            </p>
            <p>
              La fuente publica la variación redondeada. Por eso un cambio muy pequeño puede aparecer como{' '}
              <span class="font-medium text-slate-900">0,00 hm³</span> aunque el volumen semanal haya cambiado
              ligeramente. Cuando la variación no está disponible, se muestra cero y el embalse cuenta como estable.
            </p>
          </div>
        </section>

        <section id="frescura" class="surface scroll-mt-24 p-5 sm:p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
              <RefreshCw class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-slate-950">Frescura y respaldo</h2>
          </div>
          <div class="mt-4 max-w-3xl space-y-3 text-[15px] leading-relaxed text-slate-600">
            <p>
              El build descarga el catálogo, los detalles y el histórico de hasta 60 semanas, y escribe un snapshot
              JSON que se publica junto al sitio. Si la API falla durante el build, se conserva el snapshot anterior y
              la web sigue mostrando el último boletín disponible con su fecha.
            </p>
            <p>
              En la ficha de cada embalse, el bloque <strong class="font-semibold text-slate-900">Última lectura</strong>{' '}
              permite consultar una lectura reciente del organismo de cuenca. Es una petición puntual, opcional y
              separada del dato semanal; se marca como provisional y no sustituye al boletín del MITECO.
            </p>
          </div>
        </section>

        <section id="atribucion" class="surface scroll-mt-24 p-5 sm:p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
              <ExternalLink class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-slate-950">Atribución y licencia</h2>
          </div>
          <div class="mt-4 max-w-3xl space-y-3 text-[15px] leading-relaxed text-slate-600">
            <p>
              <strong class="font-semibold text-slate-900">Datos procesados por MapasDeEmbalses.es.</strong> Fuente
              original: MITECO (Boletín Hidrológico Semanal). Los datos públicos se reutilizan bajo licencia{' '}
              <a href="https://creativecommons.org/licenses/by/4.0/deed.es" target="_blank" rel="noreferrer" class="link-underline font-medium text-blue-700">
                Creative Commons CC BY 4.0
              </a>
              .
            </p>
            <p>
              La atribución a MapasDeEmbalses.es identifica la capa de normalización y distribución; no atribuye a ese
              proyecto la titularidad de los datos públicos de origen. Puedes consultar las condiciones de la API en su{' '}
              <a href="https://mapasdeembalses.es/aviso-legal/#legal-api" target="_blank" rel="noreferrer" class="link-underline font-medium text-blue-700">
                aviso legal
              </a>
              .
            </p>
            <div class="flex flex-wrap gap-3 pt-1">
              <a
                href="https://www.miteco.gob.es/es/agua/temas/evaluacion-de-los-recursos-hidricos/boletin-hidrologico/"
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition-colors hover:border-slate-300 hover:text-slate-950"
              >
                Boletín del MITECO <ExternalLink class="h-3 w-3" aria-hidden="true" />
              </a>
              <a
                href="https://mapasdeembalses.es/"
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition-colors hover:border-slate-300 hover:text-slate-950"
              >
                MapasDeEmbalses.es <ExternalLink class="h-3 w-3" aria-hidden="true" />
              </a>
            </div>
          </div>
        </section>

        <section id="limites" class="surface scroll-mt-24 p-5 sm:p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
              <TriangleExclamationPoint class="h-4 w-4" aria-hidden="true" />
            </span>
            <h2 class="text-lg font-semibold tracking-[-0.02em] text-slate-950">Límites de uso</h2>
          </div>
          <div class="mt-4 max-w-3xl space-y-3 text-[15px] leading-relaxed text-slate-600">
            <p>
              Este panel es una herramienta de consulta y divulgación. No sustituye a los avisos oficiales de las
              confederaciones hidrográficas ni a los servicios de emergencia. Para decisiones de explotación, seguridad
              o protección civil, consulta siempre las fuentes oficiales y los datos del SAIH correspondiente.
            </p>
            <p>
              Los datos pueden estar sujetos a revisión por parte del organismo publicador. Si detectas una
              discrepancia, contrasta primero con el boletín del MITECO y con la ficha de la fuente normalizada.
            </p>
          </div>
        </section>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a href="/" class="inline-flex items-center gap-2 rounded-full bg-blue-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-blue-800">
            Volver al panel
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <a href="/#embalses" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 transition-colors hover:text-slate-950">
            Explorar los embalses
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </article>

      <aside class="hidden lg:block">
        <div class="surface sticky top-24 p-5">
          <p class="eyebrow">En resumen</p>
          <ul class="mt-3 space-y-3 text-sm leading-relaxed text-slate-600">
            <li class="flex gap-2">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-500" aria-hidden="true"></span>
              Referencia semanal del MITECO, normalizada por MapasDeEmbalses.es.
            </li>
            <li class="flex gap-2">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500" aria-hidden="true"></span>
              Agregados ponderados por capacidad, solo con embalses que tienen dato.
            </li>
            <li class="flex gap-2">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
              Sin interpolaciones: los valores ausentes no se convierten en cero.
            </li>
            <li class="flex gap-2">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500" aria-hidden="true"></span>
              Consulta divulgativa; no sustituye avisos oficiales.
            </li>
          </ul>
          <p class="mt-5 border-t border-slate-100 pt-4 text-[11px] leading-relaxed text-slate-500">
            Última referencia: {dateLabel}. Catálogo: {embalses.length} de {totalCatalogo} embalses con dato.
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
